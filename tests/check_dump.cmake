if(NOT DEFINED DUMP_DIR)
  message(FATAL_ERROR "DUMP_DIR is required")
endif()
file(GLOB ppms "${DUMP_DIR}/frame_*.ppm")
list(LENGTH ppms count)
if(NOT count EQUAL 2)
  message(FATAL_ERROR "expected 2 PPM files, found ${count}")
endif()
foreach(ppm IN LISTS ppms)
  file(READ "${ppm}" header LIMIT 2 HEX)
  if(NOT header STREQUAL "5036")
    message(FATAL_ERROR "${ppm} is not a P6 PPM")
  endif()
endforeach()
